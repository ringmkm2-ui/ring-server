{
  "name": "brochat-admin",
  "version": "2.1.1",
  "description": "Bro Chat 管理者用ツール",
  "author": "Bro Chat",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node check.js",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.brochat.admin",
    "productName": "BroChatAdmin",
    "files": ["main.js", "preload.js", "renderer/**", "assets/icon.png"],
    "directories": { "output": "dist", "buildResources": "assets" },
    "win": { "target": "portable", "artifactName": "BroChatAdmin.exe", "icon": "assets/icon.png" }
  }
}
