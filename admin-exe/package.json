{
  "name": "brochat-admin",
  "version": "1.0.0",
  "description": "Bro Chat 管理者用ツール",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.brochat.admin",
    "productName": "BroChatAdmin",
    "files": ["main.js", "preload.js", "renderer/**"],
    "directories": { "output": "dist" },
    "win": { "target": "portable", "artifactName": "BroChatAdmin.exe" }
  }
}
