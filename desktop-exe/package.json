{
  "name": "brochat-desktop",
  "version": "1.0.3",
  "description": "Bro Chat デスクトップ版",
  "main": "main.js",
  "private": true,
  "author": "Ring",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.brochat.desktop",
    "productName": "Bro Chat",
    "files": ["main.js", "preload.js", "assets/icon.png"],
    "directories": { "output": "dist", "buildResources": "assets" },
    "win": { "icon": "assets/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "BroChatSetup.exe",
      "shortcutName": "Bro Chat",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": { "artifactName": "BroChat.exe" }
  }
}
